/data-panorama-remediation-history ([{"altText":"Flowchart of a software development pipeline: starts with \\u0027Plan\\u0027 \(issues, project board, roles\), then \\u0027Code\\u0027 \(branches, commits, pull requests\), followed by \\u0027Test\\u0027 \(unit, integration, quality gates\), and \\u0027Build\\u0027 \(GitHub Actions, artifacts, releases\). It shows an automated CI/CD pipeline with testing, scanning, deploying, feedback, and deployment to cloud, Kubernetes, staging, secured with credentials, secrets, and encryption.","pageNumber":0,"geomIndex":-1,"decorative":false,"imageIndex":-1,"identifiers":{"ELEMENT_ID":"11","ELEMENT_INDICES":"[1, 1, 9]"},"issueTypeId":"MissingAlternativeTextIssue:PDF","dismiss":false,"pageNumbers":[1],"coordinatesList":[[75.5,593.25,462.0,204.25]]}])
